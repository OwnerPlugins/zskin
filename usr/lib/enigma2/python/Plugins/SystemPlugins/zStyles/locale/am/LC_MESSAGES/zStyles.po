msgid "All png are removed from folder!"
msgstr "ሁሉም png ከአቃፊ ተወግደዋል!"

msgid "Close"
msgstr "ገጠመ"

msgid "Current skin can not styled!"
msgstr "አሁን ያለው ቆዳ በቅጥ መስተካከል አይችልም!"

msgid "Default"
msgstr "ነባሪ"

msgid "Del Line"
msgstr "ዴል መስመር"

msgid "Exit"
msgstr "ውጣ"

msgid "File Commander - Addon"
msgstr "የፋይል አዛዥ - አዶን"

msgid "Import Api Key OMDB from /tmp/omdbapikey.txt?"
msgstr "Api Key OMDB ከ /tmp/omdbapikey.txt አስመጣ?"

msgid "Import Api Key TMDB from /tmp/tmdbapikey.txt?"
msgstr "የኤፒ ቁልፍ TMDB ከ /tmp/tmdbapikey.txt አስመጣ?"

msgid "Info..."
msgstr "መረጃ..."

msgid "Ins Line"
msgstr "ኢንስ መስመር"

msgid "Missing %s !"
msgstr "%s ይጎድላል!"

msgid "No previous styled skin - restore canceled!"
msgstr "ምንም ቀዳሚ የቅጥ የተሰራ ቆዳ የለም - ወደነበረበት መመለስ ተሰርዟል!"

msgid "OMDB API:"
msgstr "OMDB ኤፒአይ፡"

msgid "OMDB ApiKey Imported & Stored!"
msgstr "OMDB ApiKey መጥቷል እና ተከማችቷል!"

msgid "PRESET"
msgstr "ቅድመ ሁኔታ"

msgid "Preserve preview if not defined:"
msgstr "ካልተገለጸ ቅድመ እይታን አስቀምጥ፡-"

msgid "Read Apikey OMDB from file /tmp/omdbapikey.txt"
msgstr "Apikey OMDB ከፋይል /tmp/omdbapikey.txt አንብብ"

msgid "Read Apikey TMDB from file /tmp/tmdbapikey.txt"
msgstr "Apikey TMDB ከፋይል /tmp/tmdbapikey.txt አንብብ"

msgid "Read style configuration from skin:"
msgstr "የቅጥ ውቅር ከቆዳ አንብብ፡-"

msgid "Remove all png Poster:"
msgstr "ሁሉንም png ፖስተር አስወግድ፡"

msgid "Reset skin"
msgstr "ቆዳን እንደገና ያስጀምሩ"

msgid "Reset skin?"
msgstr "ቆዳ እንደገና ይጀምር?"

msgid "Restart GUI now?"
msgstr "GUI አሁን እንደገና ይጀመር?"

msgid "Save"
msgstr "አስቀምጥ"

msgid "Set Your Apikey OMDB"
msgstr "የእርስዎን Apikey OMDB ያዘጋጁ"

msgid "Set Your Apikey TMDB"
msgstr "የእርስዎን Apkey TMDB ያዘጋጁ"

msgid "Setup"
msgstr "ማዋቀር"

msgid "Skin exist!! Do you really want to Upgrade?"
msgstr "ቆዳ አለ!! በእርግጥ ማሻሻል ይፈልጋሉ?"

msgid "Skin update:"
msgstr "የቆዳ ዝማኔ;"

msgid "Style presets contains errors!"
msgstr "የቅጥ ቅድመ-ቅምጦች ስህተቶች አሉት!"

msgid "Style your zSkin"
msgstr "የእርስዎን zSkin ቅጥ ያድርጉ"

msgid "TMDB API:"
msgstr "TMDB ኤፒአይ፡"

msgid "TMDB ApiKey Imported & Stored!"
msgstr "TMDB ApiKey መጥቷል እና ተከማችቷል!"

msgid "The skin is not styled - restore canceled!"
msgstr "ቆዳው አልተሰራም - ወደነበረበት መመለስ ተሰርዟል!"

msgid "The skin not exists - restore canceled!"
msgstr "ቆዳው የለም - ወደነበረበት መመለስ ተሰርዟል!"

msgid "Would you really reset this skin?"
msgstr "ይህን ቆዳ በእርግጥ ዳግም ያስጀምሩት?"

msgid "play/show Files"
msgstr "ፋይሎችን አጫውት/አሳይ"
